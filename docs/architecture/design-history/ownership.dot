digraph ownership {
 graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.3,ranksep=0.6,fontname="DejaVu Sans",fontsize=18,label="Proposed ownership — implementation pending",labelloc=t];
 node [shape=box,style="rounded,filled",fillcolor="#f1f3f5",fontname="DejaVu Sans",fontsize=12];
 edge [fontname="DejaVu Sans",fontsize=10,color="#4b5563"];
 client [label="BellTeam / MCP caller\nBot orchestration and presentation"];
 entry [label="index.ts\nPublic schema / receipts / isError"];
 core [label="core.ts\nGeneration + locks + lifecycle + native admission\nOwns effect ordering and return to caller"];
 meta [label="A1: agent-metadata-reader.ts\nSelect + validate + normalize saved launch\nNo lifecycle write",fillcolor="#deedff"];
 shared [label="agent-shared / lifecycle / state-root\nPaths, generation, write, common lineage"];
 native [label="tmux-runtime / process-* / native-session\nCreate / observe / input / stop with identity"];
 output [label="A2: pty-output.ts\nControl removal + display reduction\nExisting core exports retained",fillcolor="#deedff"];
 config [label="A3: harnesses/*-configure.ts\nClaude / Codex picker steps\nExisting parsers and UI port",fillcolor="#deedff"];
 defaults [label="A3: user-config.ts (existing owner)\nLock + snapshot + restore common defaults",fillcolor="#deedff"];
 parent [label="ParentDeliveryManager\nReserve / watch / recover / submit\nOwns claims, checkpoints and receipt projection"];
 record [label="A4b: parent-delivery-record.ts\nRecord schema + read + answer framing",fillcolor="#deedff"];
 remotecontract [label="A4a: remote-contract.ts\nInput schemas / types / description",fillcolor="#deedff"];
 remote [label="remote.ts\nSSH / MCP transport / credential memory\nRe-exports original contract names"];
 steer [label="Steer public SDK / CLI\nExisting exports, arguments and errors"];
 channel [label="S1: channel.ts -> channel-state.ts\nVendor output -> persistent transitions",fillcolor="#deedff"];
 hooks [label="Steer vendor queue / hooks / wake\nEmitted is not vendor acceptance"];
 bridge [label="grokbot-bridge\nOwns DB / reservations / receipts\nRead-only storage dependencies unchanged"];
 client -> entry [label="request / typed result",dir=both];
 entry -> core [label="validated request"];
 core -> meta [label="read / valid record or error",dir=both];
 meta -> shared [label="paths + generation"];
 core -> shared [label="write / lifecycle"];
 core -> native [label="identity-pinned effects"];
 core -> output [label="already observed text"];
 core -> config [label="UI effects + beforeChange"];
 core -> defaults [label="action inside config lock"];
 core -> parent [label="turn boundary / completion"];
 parent -> record [label="read / validate / frame"];
 record -> remotecontract [label="saved target schema"];
 parent -> remote [label="remote observe / answer"];
 remote -> remotecontract [label="shared input contract"];
 parent -> steer [label="profile + parent + delivery ID"];
 steer -> channel [label="channel calls"];
 steer -> hooks [label="single delivery calls"];
 bridge -> steer [label="unchanged API / CLI",dir=both];
 bridge -> channel [label="read UUID directories",style=dashed];
 meta -> output [style=invis];
 native -> config [style=invis];
 defaults -> parent [style=invis];
 config -> parent [style=invis];
}
