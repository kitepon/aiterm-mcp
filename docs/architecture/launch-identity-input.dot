digraph launch {
 graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.45,ranksep=0.45,label="Current launch → identity → input boundaries (initial detail)",labelloc=t,fontname="DejaVu Sans",fontsize=17];
 node [shape=box,style="rounded,filled",fillcolor="#edf4ff",fontname="DejaVu Sans",fontsize=12];
 edge [fontname="DejaVu Sans",fontsize=10,color="#526070"];
 request [label="index.ts: launchAgent\nMCP validation / request context"];
 root [label="claude-config-root.ts: resolveClaudeConfigurationRoot\ndefault ~/.claude (selector unset) or child of AITERM_CLAUDE_CONFIG_ROOTS\nelse AGENT_CONFIGURATION_ROOT_REJECTED",fillcolor="#eaf7ed"];
 fork [label="core.ts: resolveForkSource (ADR 0140)\nclaude-code / codex-cli + prompt; main metadata (closed main: <seat>.fork-source.json) + saved conversation\nwrite-ban.ts probe: Linux Landlock / macOS sandbox-exec / Windows restricted token + marker-SID deny ACE\nlaunch = ban prefix + CLI (--resume main --fork-session | codex fork main)",fillcolor="#eaf7ed"];
 caller [label="Caller launch fields (all five harnesses)\nappend_system_prompt / mcp_config → 0600 files in launch state (Aiterm state only)\nparseCallerMcp: http servers, literal | ${NAME} | Bearer ${NAME}; ${NAME} needs env_vars value or AITERM_*\nclaude: files + flags | codex: -c developer_instructions + -c mcp_servers.NAME\ngrok: --rules + --agent <agent.md mcpServers list> | cursor: first-prompt block + --plugin-dir\nantigravity: --add-dir seat folder (.agents/rules/aiterm.md always_on + .agents/mcp_config.json) + --settings trustedWorkspaces\nunexpressible / missing env / same-name codex stdio → refused before start",fillcolor="#eaf7ed"];
 inputref [label="Input refusal (all harnesses)\nAGENT_LAUNCH_NOT_STARTED + _meta aiterm/launch_error\nphase input, effect not_started, session_created false",fillcolor="#ffe6e6"];
 entry [label="core.ts: openAgentWithInitialPrompt → openAgent\nnew launch / dormant resume / optional prompt"];
 create [label="openAgent: withNativeSessionCreation\ncreate → openSessionInternal (managed Claude / Codex)"];
 mux [label="tmux-runtime.ts: tmuxNewSession\ncreate terminal; captureNativeSessionReceipt"];
 identity [label="core.ts: created callback → processStartIdentities\nserver PID + pane PID → native birth identities\nWindows default 10s; explicit caller budget wins",fillcolor="#fff2d7"];
 verify [label="verifyCreatedNative: session/pane route, then births\nknown mismatch → replacement\nnull birth → identity-read failure"];
 fail [label="Missing identity → refuse current operation\nno persistent blocked state; next operation reads afresh",fillcolor="#ffe6e6"];
 launch [label="core.ts: create / send launch command\nmetadata / settings / original vendor environment"];
 ready [label="prepareAgentInput / waitAgentTuiReady\nTUI observation + native harness observation\n(startup screen states S0-S6: launch-identity-input.md)"];
 startupact [label="*StartupAction (codex / claude / grok / antigravity)\nscreen -> keys (trust / notice / dialog)\nanswered once per kind; agy notice re-answered <= 1/s",fillcolor="#fff2d7"];
 startupwait [label="Blocked screen waited out until ready budget\n(unanswered or already answered; poll 500 ms)\nleaves by itself -> ready",fillcolor="#fff2d7"];
 startupref [label="startupBlockedRefusal\nbudget ended on a blocked screen, or Claude onboarding\nclose own pane -> AGENT_STARTUP_BLOCKED reason",fillcolor="#ffe6e6"];
 resume [label="resumeAgentInLock\nstandard-speed busy Codex needs native running turn",fillcolor="#f2ecff"];
 input [label="submitAgentComposerText\npaste → visibility check / delay → Enter"];
 after [label="Caller observes submit residue / turn start\nreceipt distinguishes not_sent / unconfirmed / started"];
 receipt [label="index.ts: structuredContent / fail\nlaunch receipt has no launch_id field"];
 observe [label="pty_observe\ncurrent launch ID / existence / native identity\nseparate observation, no screen or raw argv"];
 request -> caller [label="append_system_prompt / mcp_config"];caller -> entry;caller -> inputref [label="refused",style=dashed];inputref -> receipt;request -> root [label="configuration_root"];root -> entry;request -> entry;request -> fork [label="fork_from"];fork -> entry [label="fork_of / cwd / root"];entry -> create [label="new terminal path"];entry -> resume [label="hibernated / verified failed recovery\nroot change only if <root>/projects/<slug>/<vsid>.jsonl exists"];
 setup [label="openSessionInternal: scoped setup rollback\nnew-session window witness -> receipt -> session-local token\ntransfer / restore names before birth callback"];
 rollback_setup [label="Setup throw: tuple + creation marker -> conditional own close\nNo birth read; replacement preserved; original error retained",fillcolor="#ffe6e6"];
 create -> setup;setup -> mux;mux -> identity [label="captured receipt / marker transfer"];
 setup -> rollback_setup [label="identity / env / log / offset failure"];
 rollback_setup -> receipt;
 identity -> fail [label="null / unavailable"];fail -> receipt;
 identity -> verify [label="both identities recorded"];
 verify -> launch [label="same target, readable births"];
 verify -> fail [label="null or known mismatch"];
 fail -> verify [label="later caller operation",style=dashed];
 launch -> ready;resume -> ready;ready -> input [label="optional body, readiness proven"];
 ready -> receipt [label="promptless startup ready"];
 ready -> startupact [label="screen sample"];startupact -> ready [label="keys sent; resample"];
 ready -> startupwait [label="blocked, no new answer"];startupwait -> ready [label="resample"];
 startupwait -> startupref [label="budget ended"];ready -> startupref [label="onboarding / not blocked"];startupref -> receipt;
 input -> after;after -> receipt;
 observe -> identity [label="other read path, not old receipt completion",style=dashed];
}
