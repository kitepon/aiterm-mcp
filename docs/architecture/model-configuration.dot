 edge [fontname="DejaVu Sans",fontsize=10,color="#4b5563"];
 request [label="configureAgent\nValidate session / generation / input-ready"];
 lock [label="core: native + send lock, goal protection\nuser-config: snapshot + action + restore"];
 port [label="agent-model-ui.ts: AgentModelUi (internal type)\nread screen / submit complete command / menu keys\nExisting ready or text wait supplied by core",fillcolor="#deedff"];
 claude [label="harnesses/claude-configure.ts\nOpen picker -> inspect rows / effort\nRequire session-only -> recheck selection",fillcolor="#deedff"];
 codex [label="harnesses/codex-configure.ts\nOpen picker -> preserve current effort if needed\nResolve missing model only on existing fallback",fillcolor="#deedff"];
 sideeffect [label="beforeChange at original position\nClaude: before s\nCodex: before final effort key / Enter",fillcolor="#fff1d5"];
 observe [label="Observe new vendor notice\nClaude session-only result + ready\nCodex increased notice count"];
 result [label="core: preserve metadata / goal / defaults ordering\nReturn same public result or exception"];
 failure [label="Failure before or after effect\nPreserve code + unconfirmed state\nExisting bounded Esc cleanup; no resend",fillcolor="#ffe9e4"];
 preview [label="idle-settings.ts: shared native preview\ninspectCodexResumeSettings: fresh thread-id + settings\nCancel without save; missing / mismatch => null",fillcolor="#deedff"];
 repair [label="R1-L: completeFailedCodexResume\nOwns native pin / composer gate / admission",style="rounded,filled",fillcolor="#fff1d5"];
 repair -> preview [label="fresh thread + explicit standard speed"];
 restore_resume [label="R1-L settings mismatch
Existing goal pause / native turn-end check / owned resume
keepingCodexDefaults + configureCodexModel
Re-preview thread / model / effort / speed",fillcolor="#deedff"];
 preview -> restore_resume [label="same thread; known model / effort mismatch"];
 restore_resume -> codex [label="guarded native UI"];
 restore_resume -> preview [label="verify final native settings"];
 preview -> failure [label="unknown / other thread / fast / no ready"];
 request -> lock;
 lock -> port;
 port -> claude;
 port -> codex;
 claude -> sideeffect;
 codex -> sideeffect;
 sideeffect -> observe;
 observe -> result;
 claude -> failure [label="refusal / unreadable"];
 codex -> failure [label="refusal / unreadable"];
 observe -> failure [label="notice / ready missing"];
 failure -> result [label="same exception; original restore behavior"];
}
