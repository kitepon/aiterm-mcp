digraph parent {
 graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.5,ranksep=0.5,label="Current Aiterm child capture / parent delivery and recovery",labelloc=t,fontname="DejaVu Sans",fontsize=18];
 node [shape=box,style="rounded,filled",fillcolor="#edf4ff",fontname="DejaVu Sans",fontsize=12];
 edge [fontname="DejaVu Sans",fontsize=10,color="#536070"];
 request [label="prepare(parent): recover + verify\nrequest: freeze parent + optional execution source"];
 before [label="before_send: per-child registration FIFO\nbeforeChange: previous answer must be captured\npersist original record + exclusive claim"];
 bind [label="Public: Claude / Cursor binding\nPrivate: graph + companion admission\nthen state = waiting"];
 watch [label="watch fixed session / launch / operation / cursor\nobserve child completion; read genuine answer"];
 ready [label="Persist answer / child outcome: ready\nrelease child claim; next child input may proceed"];
 sending [label="Persist sending → submit parent once\nSteer owns vendor queue / hook / output"];
 result [label="submitted / failed / unknown\narchive result; status projects Codex hook state\nreceipt is not parent work completion"];
 unknown [label="Dispatch / bind / checkpoint uncertain\nretain original diagnosis; no body replay",fillcolor="#fff0d8"];
 close [label="manager close: stop timer / new prepare\nawait registration; abort waiting observers\nawait in-flight capture / delivery; owner.closed"];
 recover [label="Other owner: heartbeat + PID + birth identity\nalive/new unjudged skipped; ended/unverified paths\nrename original record to one recovery owner"];
 route [label="Recovered sending → unknown, no resend\nwaiting → watch; ready → verify then deliver\nprivate requires source / graph recovery admission"];
 retain [label="Private checkpoint uncertainty retains claim\nold owner directory removal separately guarded\nbest-effort cleanup is not delivery replay"];
 record [label="parent-delivery-record.ts\nstrict schema / source-owner references\nfilename + ID / ENOENT vs invalid / answer framing"];
 before -> record [label="schema"];recover -> record [label="read / same rejection"];sending -> record [label="answerMessage"];
 request -> before;before -> bind;bind -> watch;watch -> ready;ready -> sending;sending -> result;
 bind -> unknown [label="uncertain preparation",style=dashed];watch -> ready [label="observe failure saved as error notice",style=dashed];watch -> unknown [label="dispatch failed callback aborts",style=dashed];
 sending -> unknown [label="unknown checkpoint / receipt",style=dashed];unknown -> retain;
 request -> close [style=dashed,label="MCP shutdown"];close -> recover [label="unfinished records retained"];recover -> route;route -> watch [label="waiting"];route -> sending [label="ready admitted"];route -> result [label="terminal / failure / interrupted sending"];result -> retain [style=dashed];
}
