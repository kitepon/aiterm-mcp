digraph remote_terminal {
 graph [rankdir=LR,bgcolor="white",pad=0.3,nodesep=0.45,ranksep=0.6,label="Terminal seats (C3/C7/C8): one launch path, later calls by session",labelloc=t,fontname="DejaVu Sans",fontsize=18];
 node [shape=box,style="rounded,filled",fillcolor="#edf4ff",fontname="DejaVu Sans",fontsize=11];
 edge [fontname="DejaVu Sans",fontsize=9,color="#536070"];
 terminals [label="BellTeam terminals.connection\n(UID1001)",fillcolor="#f0f0f0"];
 server [label="aiterm-remote-terminal (UID1000 stdio MCP)\none process per connection\nbinding store remote-bindings.json 0600"];
 execution [label="BellTeam execution\nseat lifecycle / delivery / Throughline ingest",fillcolor="#f0f0f0"];
 tools [label="Aiterm launch tools (execution-native-server, UID1000)\nagent_launch (claude-code, codex-cli) / claude_agent ... + terminal (os?) + cwd\ncwd native: /... on macOS+Linux, X:\\... on Windows\ncodex-cli: terminal Aiterm >= 0.70.7\nT1 binding+revisions, T2 session map"];
 trusted [label="remote.ts trusted target\n-F /dev/null, strict known_hosts, key file\nper-call ssh / wait_process / transcript"];
 keeper [label="forward keeper (T3 lock, 60 s check in every active process)\nssh -N -R 127.0.0.1:P:127.0.0.1:D\n(P, D = seat_ingress_port in binding; no env, no default)"];
 trust [label="remote_terminal_status / trust-confirm\nbinding -> credential + trust revisions\nscan trusted only on confirmed fingerprint"];
 open [label="remote_terminal_open\ntarget + os? + revisions must match binding\nresult {opened, remoteVersion, platform}\nprivate ssh-agent: ssh-add key file"];
 platform [label="platform probe (R20, T4 cache per ref)\nshell probe + uname -s -> macos|linux|windows + shell posix|powershell|cmd\nos mismatch: TERMINAL_OS_MISMATCH\nunknown system: TERMINAL_PLATFORM_UNSUPPORTED"];
 shellcmd [label="terminalCommand(shell, {posix, windows}) (R21)\nposix: /bin/sh -c + login PATH + runtime first\nwindows: preamble (runtime bin first), body, exit-code epilogue\ncmd: powershell -EncodedCommand\nprogram call: & 'prog' 'arg' + Get-Command guard"];
 ssh [label="ssh -F /dev/null StrictHostKeyChecking=yes\nUserKnownHostsFile=trust file\nIdentityAgent=private socket, BatchMode"];
 conn [label="bound connection\ncall / transcript_read / command(op)\nevents ready|lost|closed / close"];
 rmcp [label="terminal: aiterm-mcp --private-env-stdin\nprivate env map (not process.env)"];
 launch [label="terminal: agent_launch\ncwd must exist (CWD_UNAVAILABLE)\n0600 launch env file + prompt/MCP files\nnative setup failure: rollback + complete listing\nname absent -> AGENT_LAUNCH_NOT_STARTED (native_reason)"];
 pane [label="terminal pane: cd cwd && . envfile && rm envfile && claude\n--append-system-prompt-file --mcp-config\n(codex: -c developer_instructions / -c mcp_servers.NAME={...} env refs only)\nno env values in PTY / log",fillcolor="#fff7e6"];
 jsonl [label="terminal: aiterm-transcript-read\nclaude projects jsonl from {claudeSessionId, offset}"];
 cmd [label="fixed ops: claude --version (or ~/.local/bin/claude, Windows .local\\bin\\claude.exe)\nofficial install.sh (Windows: install.ps1) / claude update"];
 fwd [label="R12 reverse forward\nterminal 127.0.0.1:P (stable per terminal)\n-> container 127.0.0.1:D\n(D from the launch's /api/seat-mcp URLs)"];
 bt [label="BellTeam seat ingress (container loopback)\n/api/seat-mcp, /api/seat-mcp/call-bridge",fillcolor="#f0f0f0"];
 authorize [label="authorize-key --ref R (R14)\ntrust + held key checked before stdin\npassword stdin -> askpass socket -> ssh, one attempt\nappend public key to ~/.ssh/authorized_keys\nWindows (--os windows): PowerShell script on stdin,\nadministrators_authorized_keys + ACL, or ~/.ssh"];
 provision [label="provision --ref R (R16, before MCP)\ntrusted key SSH, /bin/sh -s bootstrap (macOS, Linux x64/arm64)\nlinux: system tmux or PROVISION_TMUX_MISSING before download\nWindows x64: PowerShell bootstrap on stdin, system psmux or PROVISION_PSMUX_MISSING\nstage, sha256, runtime-smoke, current/previous (Windows: current junction)"];
 runtime [label="terminal ~/.aiterm/runtime/current\nnode + aiterm-mcp (+ tmux with own libs on macOS only)\nlinux uses the system tmux, Windows the system psmux\nbin first on PATH (terminalCommand)",fillcolor="#fff7e6"];
 assets [label="GitHub Release assets (R17)\naiterm-runtime-V-darwin|linux-arm64|x64.tar.gz + win32-x64.zip + one SHA256SUMS\nruntime.yml: macOS, ubuntu and windows build jobs, one publish job",fillcolor="#f0f0f0"];
 pathops [label="terminal: path-status / make-dir / list-dirs (R15)\n{exists, directory, writable}\nnative path form (POSIX or X:\\...)\nlist-dirs: {home, path, exists, directory, entries, truncated}, read only\nFOLDER_NOT_PERMITTED"];
 terminals -> server [label="stdio via seat runner"];
 server -> trust [label="R1 ref"];
 trust -> terminals [label="revisions (public)"];
 server -> open [label="R2 ref, target, revisions, private env"];
 open -> platform [label="R20 before MCP"];
 platform -> shellcmd [label="shell kind (T4)"];
 shellcmd -> ssh [label="every trusted command"];
 shellcmd -> keeper [label="stdin-blocking remote command\ncat >/dev/null | ReadToEnd()",style=dashed];
 platform -> ssh [label="trusted probe run"];
 open -> ssh [label="R3/R4"];
 ssh -> rmcp [label="R5 private-env line, then MCP"];
 open -> conn;
 conn -> terminals [label="R11 events / typed errors"];
 terminals -> execution [label="terminal value (ref, target, revisions)"];
 execution -> tools [label="R6 launch with terminal + cwd; then session_id only"];
 tools -> execution [label="R18 not started: _meta aiterm/launch_error\n{code, phase terminal, action (Japanese)}\nR19 any coded refusal (launch or session tool):\n_meta aiterm/error_code {code}",style=dashed];
 tools -> platform [label="R20 before the version probe\nterminal.os compared"];
 tools -> trusted [label="launch: private env line R5\nlater: same tool"];
 trusted -> rmcp [label="R4/R5"];
 tools -> keeper [label="ensure while bound\nD from seat URLs -> binding"];
 keeper -> fwd [label="R12"];
 terminals -> conn [label="reachability, C8 command"];
 rmcp -> launch;
 launch -> pane [label="R7"];
 tools -> launch [label="mcp_config seat URLs -> http://127.0.0.1:P\nheaders -> ${AITERM_MCP_HEADER_n}",style=dashed];
 pane -> fwd [label="R8 http://127.0.0.1:P"];
 fwd -> bt [label="R12"];
 trusted -> jsonl [label="R9 aiterm-transcript-read by session"];
 jsonl -> execution [label="entries + cursor",style=dashed];
 conn -> cmd [label="R10 over same ssh"];
 terminals -> authorize [label="ref + password on stdin"];
 authorize -> terminals [label="AUTHORIZED / ALREADY / typed error"];
 terminals -> provision [label="ref"];
 provision -> runtime [label="R16"];
 assets -> runtime [label="curl + sha256",style=dashed];
 runtime -> rmcp [label="open / calls use it"];
 conn -> pathops [label="R15 path base64"];
}
