digraph remote_terminal {
 graph [rankdir=LR,bgcolor="white",pad=0.3,nodesep=0.45,ranksep=0.6,label="Bound remote terminal adapter (C3/C7/C8): terminals is the sole opener",labelloc=t,fontname="DejaVu Sans",fontsize=18];
 node [shape=box,style="rounded,filled",fillcolor="#edf4ff",fontname="DejaVu Sans",fontsize=11];
 edge [fontname="DejaVu Sans",fontsize=9,color="#536070"];
 terminals [label="BellTeam terminals.connection\n(UID1001)",fillcolor="#f0f0f0"];
 server [label="aiterm-remote-terminal (UID1000 stdio MCP)\none process per connection\nbinding store remote-bindings.json 0600"];
 execution [label="BellTeam execution\nseat lifecycle / delivery / Throughline ingest",fillcolor="#f0f0f0"];
 trust [label="remote_terminal_status / trust-confirm\nbinding -> credential + trust revisions\nscan trusted only on confirmed fingerprint"];
 open [label="remote_terminal_open\ntarget + revisions must match binding\nprivate ssh-agent: ssh-add key file"];
 ssh [label="ssh -F /dev/null StrictHostKeyChecking=yes\nUserKnownHostsFile=trust file\nIdentityAgent=private socket, BatchMode"];
 conn [label="bound connection\ncall / transcript_read / command(op)\nevents ready|lost|closed / close"];
 rmcp [label="terminal: aiterm-mcp --private-env-stdin\nprivate env map (not process.env)"];
 launch [label="terminal: agent_launch\ncwd must exist (CWD_UNAVAILABLE)\n0600 launch env file + prompt/MCP files"];
 pane [label="terminal pane: cd cwd && . envfile && rm envfile && claude\n--append-system-prompt-file --mcp-config\nno values in PTY / log",fillcolor="#fff7e6"];
 jsonl [label="terminal: aiterm-transcript-read\nclaude projects jsonl from {claudeSessionId, offset}"];
 cmd [label="fixed ops: claude --version\nofficial install.sh / claude update"];
 fwd [label="R12 reverse forward on the bound ssh\nterminal 127.0.0.1:P (allocated per connection)\n-> container 127.0.0.1:4182; ends with closed/lost"];
 bt [label="BellTeam seat ingress (container loopback)\n/api/seat-mcp, /api/seat-mcp/call-bridge",fillcolor="#f0f0f0"];
 terminals -> server [label="stdio via seat runner"];
 server -> trust [label="R1 ref"];
 trust -> terminals [label="revisions (public)"];
 server -> open [label="R2 ref, target, revisions, private env"];
 open -> ssh [label="R3/R4"];
 ssh -> rmcp [label="R5 private-env line, then MCP"];
 open -> conn;
 conn -> terminals [label="R11 events / typed errors"];
 execution -> terminals [label="R6 callTool via bound port"];
 terminals -> conn [label="remote_terminal_call"];
 conn -> rmcp [label="MCP tools"];
 rmcp -> launch;
 launch -> pane [label="R7"];
 ssh -> fwd [label="-R 127.0.0.1:0, Allocated port P"];
 conn -> launch [label="mcpConfig seat URLs -> http://127.0.0.1:P",style=dashed];
 pane -> fwd [label="R8 http://127.0.0.1:P"];
 fwd -> bt [label="R12"];
 conn -> jsonl [label="R9 over same ssh"];
 jsonl -> execution [label="entries + cursor",style=dashed];
 conn -> cmd [label="R10 over same ssh"];
}
