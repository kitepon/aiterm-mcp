  "runtime_error_store_fields": ["status", "collection", "record_count", "unacknowledged_count"],
  "vendor_keys": ["claude", "codex", "cursor", "grok"],
  "vendor_fields": ["status", "optional", "required_for"],
  "vendor_required_for": {
    "claude": ["claude_agent"],
    "codex": ["codex_agent"],
    "cursor": ["agent_launch"],
    "grok": ["grok_agent"]
  }
